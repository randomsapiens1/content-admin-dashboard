# Neon Postgres connection string (from the Vercel Marketplace / Neon integration)
DATABASE_URL=

# Vercel Blob store token (from the Vercel Blob dashboard / Marketplace)
BLOB_READ_WRITE_TOKEN=

# Single admin login
ADMIN_USERNAME=admin
# Generate with: npm run hash-password -- "your-password"
ADMIN_PASSWORD_HASH=

# Random string, 32+ characters, used to sign the session cookie
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Optional: shown as the dashboard title
NEXT_PUBLIC_SITE_NAME=Dashforge
